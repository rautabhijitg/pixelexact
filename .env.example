# Copy this file to .env.local and fill in real values there — .env.local is
# gitignored and never committed.

# REQUIRED IN PRODUCTION. The site's real public URL, no trailing slash.
# Without this, canonical tags, Open Graph URLs, sitemap.xml, robots.txt, and
# all JSON-LD (Organization/WebSite/Breadcrumb) fall back to localhost:3000 —
# set this in your hosting provider's environment variables before launch.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form email delivery (see src/app/api/contact/route.ts).

# API key from https://resend.com (Dashboard -> API Keys). Server-only, never
# exposed to the browser.
RESEND_API_KEY=your-provider-api-key

# Verified sender identity in Resend. Until you verify a domain, you must use
# the sandbox address below — Resend will reject any other "from" value.
RESEND_FROM_EMAIL="Pixel Exact <onboarding@resend.dev>"

# Business inbox that receives contact form submissions.
CONTACT_RECEIVER_EMAIL=your-email@example.com
