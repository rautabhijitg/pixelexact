# Contact form email delivery (see src/app/api/contact/route.ts).
# Copy this file to .env.local and fill in real values there — .env.local is
# gitignored and never committed.

# API key from https://resend.com (Dashboard -> API Keys).
RESEND_API_KEY=

# Verified sender identity in Resend. Until you verify a domain, you must use
# the sandbox address below — Resend will reject any other "from" value.
RESEND_FROM_EMAIL="Pixel Exact <onboarding@resend.dev>"

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=
